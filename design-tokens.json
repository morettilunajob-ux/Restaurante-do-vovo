{
  "metadata": {
    "name": "Restaurante do Vovó Design System",
    "description": "Retro-premium casual dining — family-run, grandmother-owned aesthetic elevated",
    "version": "1.0.0"
  },
  "primitives": {
    "color": {
      "red": {
        "50": "#FEF2F2",
        "100": "#FEE2E2",
        "300": "#FCA5A5",
        "600": "#DC2626",
        "700": "#B91C1C",
        "900": "#7F1D1D"
      },
      "gold": {
        "50": "#FFFBEB",
        "300": "#FCD34D",
        "500": "#F59E0B",
        "700": "#B45309",
        "900": "#78350F"
      },
      "stone": {
        "50": "#FAFAF9",
        "100": "#F5F5F4",
        "200": "#E7E5E4",
        "300": "#D6D3D1",
        "700": "#292524",
        "900": "#1C1917"
      },
      "green": {
        "600": "#16A34A",
        "700": "#15803D",
        "900": "#14532D"
      }
    },
    "typography": {
      "fontFamily": {
        "display": "'Crimson Text', 'Georgia', serif",
        "body": "'Inter', '-apple-system', 'BlinkMacSystemFont', sans-serif",
        "mono": "'JetBrains Mono', monospace"
      },
      "fontSize": {
        "xs": "0.75rem",
        "sm": "0.875rem",
        "base": "1rem",
        "lg": "1.125rem",
        "xl": "1.25rem",
        "2xl": "1.5rem",
        "3xl": "1.875rem",
        "4xl": "2.25rem",
        "5xl": "3rem",
        "6xl": "3.75rem"
      },
      "fontWeight": {
        "light": 300,
        "normal": 400,
        "medium": 500,
        "semibold": 600,
        "bold": 700,
        "extrabold": 800
      },
      "lineHeight": {
        "tight": 1.2,
        "snug": 1.375,
        "normal": 1.5,
        "relaxed": 1.625,
        "loose": 2
      },
      "letterSpacing": {
        "tight": "-0.02em",
        "normal": "0em",
        "wide": "0.02em",
        "wider": "0.05em"
      }
    },
    "spacing": {
      "0": "0",
      "2": "0.5rem",
      "4": "1rem",
      "6": "1.5rem",
      "8": "2rem",
      "10": "2.5rem",
      "12": "3rem",
      "16": "4rem",
      "20": "5rem",
      "24": "6rem",
      "32": "8rem"
    },
    "shadow": {
      "none": "none",
      "sm": "0 1px 3px rgba(0, 0, 0, 0.12)",
      "md": "0 4px 12px rgba(0, 0, 0, 0.15)",
      "lg": "0 10px 30px rgba(0, 0, 0, 0.2)",
      "xl": "0 20px 50px rgba(0, 0, 0, 0.25)"
    },
    "radius": {
      "none": "0",
      "sm": "0.25rem",
      "md": "0.5rem",
      "lg": "0.75rem",
      "full": "9999px"
    }
  },
  "semantic": {
    "color": {
      "primary": "{primitives.color.red.700}",
      "primary-light": "{primitives.color.red.600}",
      "primary-dark": "{primitives.color.red.900}",
      "secondary": "{primitives.color.gold.500}",
      "accent": "{primitives.color.gold.300}",
      "success": "{primitives.color.green.600}",
      "background": "{primitives.color.stone.50}",
      "surface": "{primitives.color.stone.100}",
      "surface-dark": "{primitives.color.stone.700}",
      "text-primary": "{primitives.color.stone.900}",
      "text-secondary": "{primitives.color.stone.700}",
      "text-muted": "{primitives.color.stone.600}",
      "text-light": "{primitives.color.stone.50}",
      "border": "{primitives.color.stone.200}",
      "border-dark": "{primitives.color.stone.300}"
    },
    "typography": {
      "heading-display": {
        "fontFamily": "{primitives.typography.fontFamily.display}",
        "fontSize": "{primitives.typography.fontSize.6xl}",
        "fontWeight": "{primitives.typography.fontWeight.bold}",
        "letterSpacing": "{primitives.typography.letterSpacing.tight}",
        "lineHeight": "{primitives.typography.lineHeight.tight}"
      },
      "heading-1": {
        "fontFamily": "{primitives.typography.fontFamily.display}",
        "fontSize": "{primitives.typography.fontSize.5xl}",
        "fontWeight": "{primitives.typography.fontWeight.bold}",
        "lineHeight": "{primitives.typography.lineHeight.tight}"
      },
      "heading-2": {
        "fontFamily": "{primitives.typography.fontFamily.display}",
        "fontSize": "{primitives.typography.fontSize.4xl}",
        "fontWeight": "{primitives.typography.fontWeight.bold}",
        "lineHeight": "{primitives.typography.lineHeight.snug}"
      },
      "heading-3": {
        "fontFamily": "{primitives.typography.fontFamily.display}",
        "fontSize": "{primitives.typography.fontSize.2xl}",
        "fontWeight": "{primitives.typography.fontWeight.semibold}",
        "lineHeight": "{primitives.typography.lineHeight.snug}"
      },
      "body-lg": {
        "fontFamily": "{primitives.typography.fontFamily.body}",
        "fontSize": "{primitives.typography.fontSize.lg}",
        "fontWeight": "{primitives.typography.fontWeight.normal}",
        "lineHeight": "{primitives.typography.lineHeight.relaxed}"
      },
      "body": {
        "fontFamily": "{primitives.typography.fontFamily.body}",
        "fontSize": "{primitives.typography.fontSize.base}",
        "fontWeight": "{primitives.typography.fontWeight.normal}",
        "lineHeight": "{primitives.typography.lineHeight.normal}"
      },
      "body-sm": {
        "fontFamily": "{primitives.typography.fontFamily.body}",
        "fontSize": "{primitives.typography.fontSize.sm}",
        "fontWeight": "{primitives.typography.fontWeight.normal}",
        "lineHeight": "{primitives.typography.lineHeight.normal}"
      }
    }
  },
  "component": {
    "button": {
      "base": {
        "padding": "{primitives.spacing.8} {primitives.spacing.10}",
        "fontSize": "{primitives.typography.fontSize.base}",
        "fontWeight": "{primitives.typography.fontWeight.semibold}",
        "borderRadius": "{primitives.radius.none}",
        "transition": "all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1)",
        "cursor": "pointer",
        "textTransform": "uppercase",
        "letterSpacing": "{primitives.typography.letterSpacing.wider}"
      },
      "primary": {
        "background": "{semantic.color.primary}",
        "color": "{semantic.color.text-light}",
        "border": "none",
        "shadow": "{primitives.shadow.md}"
      },
      "primary-hover": {
        "background": "{semantic.color.primary-dark}",
        "shadow": "{primitives.shadow.lg}",
        "transform": "translateY(-2px)"
      }
    },
    "card": {
      "base": {
        "background": "{semantic.color.surface}",
        "borderRadius": "{primitives.radius.lg}",
        "padding": "{primitives.spacing.12}",
        "shadow": "{primitives.shadow.md}",
        "border": "1px solid {semantic.color.border}",
        "transition": "all 0.3s"
      },
      "hover": {
        "shadow": "{primitives.shadow.lg}",
        "transform": "translateY(-4px)"
      }
    },
    "input": {
      "base": {
        "padding": "{primitives.spacing.6} {primitives.spacing.8}",
        "fontSize": "{primitives.typography.fontSize.base}",
        "border": "2px solid {semantic.color.border}",
        "borderRadius": "{primitives.radius.md}",
        "transition": "border-color 0.2s",
        "fontFamily": "{primitives.typography.fontFamily.body}"
      },
      "focus": {
        "borderColor": "{semantic.color.primary}",
        "outline": "none"
      }
    }
  }
}
